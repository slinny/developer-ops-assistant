DOA_WEBHOOK_SECRET=replace-with-a-random-secret
DOA_API_TOKEN=replace-with-a-separate-random-token
DOA_OPENAI_API_KEY=
DOA_MODEL=gpt-4.1-mini
DOA_DATABASE_URL=sqlite+aiosqlite:///./developer_ops.db
DOA_ATTEMPT_TIMEOUT_SECONDS=15
DOA_PROCESSING_DEADLINE_SECONDS=45
DOA_MAX_ATTEMPTS=3
DOA_RETRY_BASE_SECONDS=0.5
DOA_RETRY_CAP_SECONDS=8
DOA_RETRY_BUDGET_SECONDS=30
DOA_MAX_CONCURRENCY=4
DOA_MAX_WAITERS=16
DOA_CAPACITY_WAIT_SECONDS=2
DOA_REQUESTS_PER_WINDOW=120
DOA_RATE_WINDOW_SECONDS=60
DOA_MAX_WEBHOOK_BYTES=262144
# Optional: configure verified rates for the EXACT model returned by the provider.
# DOA_PRICING_MODEL=model-snapshot-id
# DOA_PRICING_VERSION=source-and-effective-date
# DOA_INPUT_USD_PER_MILLION=...
# DOA_CACHED_INPUT_USD_PER_MILLION=...
# DOA_OUTPUT_USD_PER_MILLION=...

# Phase 3: one worker process, bounded async pool, durable scheduler retries.
DOA_WORKER_CONCURRENCY=4
DOA_WORKER_POLL_SECONDS=0.25
DOA_JOB_LEASE_SECONDS=30
DOA_JOB_MAX_ATTEMPTS=5
DOA_JOB_BUDGET_SECONDS=3600
DOA_QUEUE_MAX_PENDING=10000
DOA_MEMORY_ENABLED=true
DOA_MEMORY_PATH=./event-memory-index
